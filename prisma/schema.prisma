generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Side {
  A
  B
  NEUTRAL
}

enum WinnerSide {
  A
  B
  NONE
}

enum BattleStatus {
  ACTIVE
  ENDED
  PAUSED
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum OutcomeType {
  LANDSLIDE
  REVERSAL
  STALEMATE
  COOLDOWN
}

enum SpeakingStyle {
  AGGRESSIVE
  BALANCED
  SUBTLE
}

enum CharacterInstanceStatus {
  ACTIVE
  LEFT
  MUTED
}

enum SnapshotWindowType {
  ALL
  LAST_N
  LAST_MINUTES
}

enum ActionType {
  SPRAY
  SARCASM
  FOLLOW_UP
  WHITEWASH
  EXPOSE
  ANALYZE
  SUMMARIZE
  AMPLIFY
  DE_ESCALATE
}

model User {
  id          String             @id @default(cuid())
  displayName String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  loadouts    UserBattleLoadout[]
  actions     UserAction[]
  instances   CharacterInstance[]
  topics      Topic[]
}

model Topic {
  id               String       @id @default(cuid())
  title            String
  description      String?
  sideAName        String
  sideBName        String
  tags             String[]
  createdByUserId  String?
  createdBy        User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  initialHeat      Int          @default(50)
  initialSwing     Int          @default(0)
  initialScoreA    Int          @default(0)
  initialScoreB    Int          @default(0)
  activeBattleId   String?      @unique
  activeBattle     BattleState? @relation("ActiveBattle", fields: [activeBattleId], references: [id], onDelete: SetNull)
  battles          BattleState[] @relation("TopicBattles")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([createdByUserId])
}

model BattleState {
  id                   String               @id @default(cuid())
  topicId              String
  topic                Topic                @relation("TopicBattles", fields: [topicId], references: [id], onDelete: Cascade)
  activeForTopic       Topic?               @relation("ActiveBattle")
  status               BattleStatus         @default(ACTIVE)
  phase                Int                  @default(0)
  heat                 Int                  @default(50)
  swing                Int                  @default(0)
  scoreA               Int                  @default(0)
  scoreB               Int                  @default(0)
  nextSpeakerHint      String?
  lastMessageAt        DateTime?
  sentimentWindowType  SnapshotWindowType   @default(LAST_N)
  sentimentWindowValue Int                  @default(50)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  messages             BattleMessage[]
  instances            CharacterInstance[]
  loadouts             UserBattleLoadout[]
  actions              UserAction[]
  sentimentRecords     SentimentRecord[]
  sentimentSnapshots   SentimentSnapshot[]
  result               BattleResult?

  @@index([topicId, status])
}

model Character {
  id                 String              @id @default(cuid())
  name               String
  persona            String
  defaultSide        Side                @default(NEUTRAL)
  speakingStyle      SpeakingStyle
  actionPool         ActionType[]
  baseInfluence      Decimal             @db.Decimal(4, 2)
  sentimentBias      Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  instances          CharacterInstance[]
}

model CharacterInstance {
  id                String                  @id @default(cuid())
  battleId          String
  battle            BattleState             @relation(fields: [battleId], references: [id], onDelete: Cascade)
  characterId       String
  character         Character               @relation(fields: [characterId], references: [id], onDelete: Restrict)
  ownerUserId       String?
  ownerUser         User?                   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  side              Side
  nickname          String?
  status            CharacterInstanceStatus @default(ACTIVE)
  cooldownUntil     DateTime?
  contributionScore Decimal                 @default(0) @db.Decimal(8, 2)
  joinedAt          DateTime                @default(now())
  messages          BattleMessage[]         @relation("SpeakerMessages")
  targetMessages    BattleMessage[]         @relation("TargetMessages")
  mvpResult         BattleResult[]          @relation("ResultMVP")
  userActions       UserAction[]

  @@index([battleId, ownerUserId])
  @@index([battleId, status])
}

model BattleMessage {
  id                String              @id @default(cuid())
  battleId          String
  battle            BattleState         @relation(fields: [battleId], references: [id], onDelete: Cascade)
  topicId           String
  topic             Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  speakerInstanceId String
  speakerInstance   CharacterInstance   @relation("SpeakerMessages", fields: [speakerInstanceId], references: [id], onDelete: Restrict)
  speakerName       String
  side              Side
  action            ActionType
  content           String
  targetInstanceId  String?
  targetInstance    CharacterInstance?  @relation("TargetMessages", fields: [targetInstanceId], references: [id], onDelete: SetNull)
  userTriggered     Boolean             @default(false)
  deltaHeat         Int                 @default(0)
  deltaSwing        Int                 @default(0)
  deltaScoreA       Int                 @default(0)
  deltaScoreB       Int                 @default(0)
  createdAt         DateTime            @default(now())
  sentimentRecord   SentimentRecord?

  @@index([battleId, createdAt])
  @@index([topicId, createdAt])
}

model UserBattleLoadout {
  id               String      @id @default(cuid())
  battleId         String
  battle           BattleState @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot1CharacterId String?
  slot2CharacterId String?
  slot3CharacterId String?
  side             Side
  lockedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([battleId, userId])
  @@index([userId, battleId])
}

model UserAction {
  id                String            @id @default(cuid())
  battleId          String
  battle            BattleState       @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  usingInstanceId   String
  usingInstance     CharacterInstance @relation(fields: [usingInstanceId], references: [id], onDelete: Restrict)
  action            ActionType
  instruction       String?
  producedMessageId String?
  producedMessage   BattleMessage?    @relation(fields: [producedMessageId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@index([battleId, userId, createdAt])
}

model SentimentRecord {
  messageId   String         @id
  message     BattleMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  battleId    String
  battle      BattleState    @relation(fields: [battleId], references: [id], onDelete: Cascade)
  label       SentimentLabel
  confidence  Decimal        @db.Decimal(4, 3)
  model       String
  createdAt   DateTime       @default(now())

  @@index([battleId, createdAt])
}

model SentimentSnapshot {
  id          String             @id @default(cuid())
  battleId    String
  battle      BattleState        @relation(fields: [battleId], references: [id], onDelete: Cascade)
  atPhase     Int
  positive    Decimal            @db.Decimal(5, 4)
  neutral     Decimal            @db.Decimal(5, 4)
  negative    Decimal            @db.Decimal(5, 4)
  sampleSize  Int
  windowType  SnapshotWindowType
  windowValue Int
  updatedAt   DateTime           @default(now())

  @@index([battleId, atPhase])
}

model BattleResult {
  battleId             String            @id
  battle               BattleState       @relation(fields: [battleId], references: [id], onDelete: Cascade)
  topicId              String
  topic                Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  outcomeType          OutcomeType
  winnerSide           WinnerSide
  finalHeat            Int
  finalSwing           Int
  finalScoreA          Int
  finalScoreB          Int
  finalPhase           Int
  mvpInstanceId        String?
  mvpInstance          CharacterInstance? @relation("ResultMVP", fields: [mvpInstanceId], references: [id], onDelete: SetNull)
  highlightMessageIds  String[]
  summaryText          String
  createdAt            DateTime          @default(now())

  @@index([topicId, createdAt])
}
